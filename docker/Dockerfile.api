FROM python:3.11-slim

WORKDIR /app

# Installation directe de uv sans image externe
RUN pip install --no-cache-dir uv

COPY pyproject.toml .
RUN uv sync --no-dev

COPY app/ ./app
COPY docker/ ./docker

EXPOSE 8000

CMD ["sh", "-c", "uv run python app/seed.py && uv run uvicorn app.main:app --host 0.0.0.0 --port 8000"]